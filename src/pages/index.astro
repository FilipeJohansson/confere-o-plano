---
import Icone from '../components/Icone.svelte';
import Base from '../layouts/Base.astro';
import { informativo, perguntas, planos, temas } from '../lib/dados';
import { PLANOS } from '../lib/planos';
import { ESCALA, NOME_PLANO } from '../lib/rotulos';

const base = import.meta.env.BASE_URL;

// Todo trecho citado no site (perguntas e seções informativas) é conferido contra o PDF no build.
const citacoes =
  perguntas.reduce((n, p) => n + PLANOS.reduce((m, pl) => m + p.posicoes[pl].citacoes.length, 0), 0) +
  informativo.so_um_lado.reduce((n, i) => n + i.citacoes.length, 0) +
  [...informativo.consenso, ...informativo.lado_a_lado].reduce((n, i) => n + PLANOS.reduce((m, pl) => m + i[pl].length, 0), 0);
const exemplo = perguntas[0];
const temasComPergunta = new Set(perguntas.map((p) => p.tema)).size;

const PASSOS = [
  {
    titulo: 'Responda sem saber de quem é',
    texto: 'Cada afirmação vem de um ponto em que os dois planos divergem. Os nomes dos candidatos só aparecem no resultado.',
  },
  {
    titulo: 'Veja o quanto concorda com cada plano',
    texto: 'Percentual geral e por tema, calculado no seu navegador. Suas respostas não são enviadas a ninguém.',
  },
  {
    titulo: 'Confira na fonte',
    texto: 'Para cada afirmação, o trecho literal de cada plano e o link para a página exata do PDF oficial no TSE.',
  },
];
---

<Base>
  <div class="flex flex-col gap-14">
    <section class="grid items-center gap-10 lg:grid-cols-[1.15fr_1fr]">
      <div class="flex flex-col gap-5">
        <div class="flex flex-wrap gap-2">
          <span class="etiqueta">Eleições 2026 · 2º turno</span>
          <span class="etiqueta">Planos registrados no TSE</span>
        </div>
        <h1 class="text-4xl font-bold tracking-tight text-balance sm:text-5xl">
          Qual plano de governo combina mais com o que você pensa?
        </h1>
        <p class="text-lg text-slate-700 dark:text-slate-300">
          Responda {perguntas.length} afirmações e veja o quanto você concorda com os planos de governo que os candidatos
          do 2º turno registraram no TSE, com o trecho e a página de cada plano para cada resposta.
        </p>
        <div class="flex flex-wrap items-center gap-3">
          <a href={`${base}quiz/`} class="botao-primario px-6 py-3 text-lg">Começar</a>
          <a href={`${base}afirmacoes/`} class="botao-secundario px-6 py-3">Ver todas as afirmações</a>
        </div>
        <p class="text-sm text-slate-600 dark:text-slate-400">Leva cerca de 5 minutos. Os nomes dos candidatos só aparecem no resultado.</p>
      </div>

      {/* Amostra decorativa de como é o questionário (a primeira afirmação, sem interação). Some no celular, onde
          os cinco botões não cabem lado a lado e a amostra só empurraria o conteúdo para baixo. */}
      <div class="cartao relative hidden flex-col gap-5 p-6 sm:flex sm:p-8" aria-hidden="true">
        <div class="flex items-center justify-between text-xs font-medium text-slate-500 dark:text-slate-400">
          <span>{temas.find((t) => t.id === exemplo.tema)?.nome}</span>
          <span>1 de {perguntas.length}</span>
        </div>
        <div class="h-1.5 rounded-full bg-slate-200 dark:bg-slate-800">
          <div class="h-full w-1/12 rounded-full bg-slate-700 dark:bg-slate-300"></div>
        </div>
        <p class="text-xl leading-snug font-semibold text-balance">{exemplo.afirmacao}</p>
        <div class="grid grid-cols-5 gap-2">
          {
            ESCALA.map((op) => (
              <div class="flex flex-col items-center gap-1.5 rounded-xl border border-slate-200 bg-white py-3 dark:border-slate-800 dark:bg-slate-950">
                <span class:list={['grid size-9 place-items-center rounded-full', op.cor]}>
                  <Icone nome={op.icone} classe="size-4" />
                </span>
                <span class="px-0.5 text-center text-[0.65rem] leading-tight font-medium text-slate-600 dark:text-slate-400">{op.texto}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="grid gap-4 sm:grid-cols-3" aria-label="Em números">
      <div class="cartao p-5">
        <p class="text-xs font-semibold tracking-wide text-slate-500 uppercase dark:text-slate-400">Afirmações</p>
        <p class="mt-1 text-3xl font-bold tabular-nums">{perguntas.length}</p>
        <p class="text-sm text-slate-600 dark:text-slate-400">em {temasComPergunta} dos 8 temas do TSE</p>
      </div>
      <div class="cartao p-5">
        <p class="text-xs font-semibold tracking-wide text-slate-500 uppercase dark:text-slate-400">Trechos citados</p>
        <p class="mt-1 text-3xl font-bold tabular-nums">{citacoes}</p>
        <p class="text-sm text-slate-600 dark:text-slate-400">conferidos automaticamente com o PDF oficial</p>
      </div>
      <div class="cartao p-5">
        <p class="text-xs font-semibold tracking-wide text-slate-500 uppercase dark:text-slate-400">Respostas enviadas</p>
        <p class="mt-1 text-3xl font-bold tabular-nums">0</p>
        <p class="text-sm text-slate-600 dark:text-slate-400">o cálculo é feito no seu navegador</p>
      </div>
    </section>

    <section class="flex flex-col gap-5">
      <div class="flex flex-wrap items-end justify-between gap-2">
        <h2 class="titulo-secao">Como funciona</h2>
        <a class="text-sm font-semibold underline underline-offset-4" href={`${base}sobre/`}>Metodologia completa, fontes e privacidade</a>
      </div>
      <ol class="grid gap-4 sm:grid-cols-3">
        {
          PASSOS.map((passo, i) => (
            <li class="cartao flex flex-col gap-2 p-5">
              <span class="grid size-8 place-items-center rounded-lg bg-slate-900 text-sm font-bold text-white dark:bg-white dark:text-slate-900">
                {i + 1}
              </span>
              <h3 class="font-semibold">{passo.titulo}</h3>
              <p class="text-sm text-slate-600 dark:text-slate-400">{passo.texto}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="flex flex-col gap-5">
      <h2 class="titulo-secao">Os planos</h2>
      <ul class="grid gap-4 sm:grid-cols-2">
        {
          PLANOS.map((p) => (
            <li class="cartao flex flex-col gap-3 p-5">
              <div class="flex items-center gap-3">
                <span class:list={['h-10 w-1.5 rounded-full', NOME_PLANO[p].barra]} aria-hidden="true" />
                <div>
                  <p class:list={['text-lg font-bold', NOME_PLANO[p].cor]}>{NOME_PLANO[p].nome}</p>
                  <p class="text-sm text-slate-600 dark:text-slate-400">
                    {NOME_PLANO[p].partido} · proposta de governo com {planos[p].paginas} páginas
                  </p>
                </div>
              </div>
              <div class="flex flex-wrap gap-x-4 gap-y-1 text-sm font-medium">
                <a class="underline underline-offset-4" href={planos[p].pagina_tse} target="_blank" rel="noopener">
                  {NOME_PLANO[p].nome} ({NOME_PLANO[p].partido}): proposta de governo no site do TSE
                </a>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="rounded-2xl bg-slate-900 px-6 py-10 text-center text-white shadow-sm sm:px-10 dark:bg-slate-800">
      <h2 class="text-2xl font-bold tracking-tight">Pronto para conferir?</h2>
      <p class="mx-auto mt-2 max-w-xl text-slate-300">
        Responda primeiro, sem saber de quem é cada posição. Depois, veja o resultado com as fontes.
      </p>
      <a
        href={`${base}quiz/`}
        class="mt-6 inline-flex items-center justify-center rounded-xl bg-white px-6 py-3 font-semibold text-slate-900 shadow-sm transition hover:bg-slate-100"
      >
        Responder agora
      </a>
    </section>
  </div>
</Base>
