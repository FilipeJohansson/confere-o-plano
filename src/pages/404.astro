---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL;
---

<Base titulo="Página não encontrada · Confere o Plano" indexar={false}>
  <div class="cartao mx-auto flex max-w-3xl flex-col gap-4 p-6 sm:p-8">
    <h1 class="text-3xl font-bold tracking-tight">Página não encontrada</h1>
    <p class="text-slate-700 dark:text-slate-300">O endereço pode ter sido digitado errado ou a página não existe mais.</p>
    <div class="flex flex-wrap gap-3">
      <a class="botao-primario" href={base}>Ir para o início</a>
      <a class="botao-secundario" href={`${base}quiz/`}>
        Responder o questionário
      </a>
    </div>
  </div>
</Base>
