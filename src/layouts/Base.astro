---
import { CHAVE_CONCLUIU, GOATCOUNTER, HOSTS_CONTADOS } from '../lib/contagem';
import BotaoTema from '../components/BotaoTema.svelte';
import { urlCorrecao } from '../lib/projeto';
import { SCRIPT_TEMA } from '../lib/tema';
import '../styles/global.css';

interface Props {
  titulo?: string;
  descricao?: string;
  /** false: pede aos buscadores para não indexar (404, resultado sem respostas). */
  indexar?: boolean;
}

const {
  titulo = 'Confere o Plano',
  indexar = true,
  descricao = 'Responda afirmações e veja com qual plano de governo do 2º turno de 2026 você mais concorda, com citações e páginas de cada plano.',
} = Astro.props;
const base = import.meta.env.BASE_URL;
const canonica = new URL(Astro.url.pathname, Astro.site);
const imagem = new URL(`${base}compartilhar.png`, Astro.site);

const NAVEGACAO = [
  { href: `${base}quiz/`, texto: 'Questionário' },
  { href: `${base}afirmacoes/`, texto: 'Afirmações' },
  { href: `${base}sobre/`, texto: 'Sobre' },
];
const atual = (href: string) => Astro.url.pathname.startsWith(href);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Antes de tudo, para o tema escuro escolhido não piscar em claro. */}
    <script is:inline set:html={SCRIPT_TEMA} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    {indexar ? <link rel="canonical" href={canonica} /> : <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Confere o Plano" />
    <meta property="og:url" content={canonica} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:image" content={imagem} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Confere o Plano: qual plano de governo do 2º turno combina mais com o que você pensa?" />
    <meta name="twitter:card" content="summary_large_image" />
    {
      import.meta.env.PROD && (
        <>
          {/* Define o caminho enviado antes de o script do GoatCounter carregar: só o pathname, nunca o "#r=".
              O script só é carregado no domínio do site (não nas prévias da Cloudflare). */}
          <script
            is:inline
            define:vars={{ chave: CHAVE_CONCLUIU, hosts: HOSTS_CONTADOS, contador: `https://${GOATCOUNTER}.goatcounter.com/count` }}
          >
            window.goatcounter = {
              endpoint: contador,
              path: function () {
                var caminho = location.pathname;
                try {
                  if (/\/resultado\/$/.test(caminho) && sessionStorage.getItem(chave)) {
                    sessionStorage.removeItem(chave);
                    return caminho + 'concluido';
                  }
                } catch (e) {}
                return caminho;
              },
            };
            if (hosts.indexOf(location.hostname) !== -1) {
              var script = document.createElement('script');
              script.async = true;
              script.dataset.goatcounter = contador;
              script.src = 'https://gc.zgo.at/count.js';
              document.head.appendChild(script);
            }
          </script>
        </>
      )
    }
  </head>
  <body class="flex min-h-dvh flex-col">
    <header class="sticky top-0 z-10 border-b border-slate-200 bg-white/90 backdrop-blur dark:border-slate-800 dark:bg-slate-950/90">
      <div class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-4 gap-y-2 px-4 py-2.5">
        <a href={base} class="flex items-center gap-2 text-lg font-bold tracking-tight">
          <span class="grid size-8 place-items-center rounded-lg bg-slate-900 text-white dark:bg-white dark:text-slate-900" aria-hidden="true">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4" /><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" /></svg>
          </span>
          Confere o Plano
        </a>
        <div class="ml-auto flex items-center gap-1 sm:order-last sm:ml-0">
          <BotaoTema client:load />
        </div>
        <nav class="order-last flex w-full gap-1 text-sm font-semibold sm:order-none sm:ml-auto sm:w-auto" aria-label="Principal">
          {
            NAVEGACAO.map((item) => (
              <a
                href={item.href}
                aria-current={atual(item.href) ? 'page' : undefined}
                class:list={[
                  'rounded-lg px-3 py-1.5 transition',
                  atual(item.href)
                    ? 'bg-slate-900 text-white dark:bg-white dark:text-slate-900'
                    : 'text-slate-700 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800',
                ]}
              >
                {item.texto}
              </a>
            ))
          }
        </nav>
      </div>
    </header>
    <main class="mx-auto w-full max-w-5xl flex-1 px-4 py-8 sm:py-12">
      <slot />
    </main>
    <footer class="mt-8 bg-slate-900 text-slate-300 dark:border-t dark:border-slate-800">
      <div class="mx-auto flex max-w-5xl flex-col gap-6 px-4 py-10 sm:flex-row sm:justify-between">
        <div class="flex max-w-sm flex-col gap-2">
          <a href={base} class="text-lg font-bold text-white">Confere o Plano</a>
          <p class="text-sm text-slate-400">
            Projeto independente, sem vínculo com o TSE, candidatos ou partidos. Compara apenas os planos de governo
            registrados no TSE, não o histórico, as falas ou os votos dos candidatos.
          </p>
        </div>
        <div class="flex flex-col gap-3 text-sm">
          <nav class="flex flex-wrap gap-x-5 gap-y-2 font-medium" aria-label="Rodapé">
            <a class="hover:text-white hover:underline hover:underline-offset-4" href={`${base}sobre/`}>Sobre e metodologia</a>
            <a class="hover:text-white hover:underline hover:underline-offset-4" href={`${base}afirmacoes/`}>Todas as afirmações</a>
            <a class="hover:text-white hover:underline hover:underline-offset-4" href={urlCorrecao()} target="_blank" rel="noopener">Reportar um erro</a>
          </nav>
          <p class="max-w-sm text-xs text-slate-400">
            Suas respostas nunca saem do seu navegador; contamos apenas visitas às páginas, de forma anônima e sem cookies.
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
