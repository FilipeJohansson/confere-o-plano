# Cabeçalhos aplicados pela Cloudflare (Workers com arquivos estáticos) a todas as páginas.
# - frame-ancestors/X-Frame-Options: o site não pode ser embutido em outra página (evita que alguém o
#   apresente dentro de um site de campanha ou falso).
# - Scripts só do próprio site e do GoatCounter; contagens só para o GoatCounter.
# - 'unsafe-inline' em script-src: o Astro e o tema usam scripts pequenos embutidos no HTML.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://gc.zgo.at; connect-src 'self' https://confereoplano.goatcounter.com; img-src 'self' data: https://confereoplano.goatcounter.com; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
